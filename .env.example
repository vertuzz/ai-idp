# Public example configuration only. Do not add real credentials to this file.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
AI_IDP_API_KEY=

# Configure a real credential only in your untracked local .env.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api

# Default model selection (verified 2026-10-17)
AI_IDP_DECISION_MODEL=perplexity/pplx-decider-v1.2
AI_IDP_RELEVANCE_MODEL=anthropic/claude-haiku-5.5
RELEVANCE_STRATEGY=decisions
AI_IDP_EXTRACTION_MODEL=anthropic/claude-haiku-5.5
AI_IDP_ESCALATION_MODEL=google/gemini-4-argon
AI_IDP_SCHEMA_SUGGESTION_MODEL=anthropic/claude-haiku-5.5
SCHEMA_SUGGESTION_MAX_COST_USD=0.05
SCHEMA_SUGGESTION_MAX_CALLS=12
SCHEMA_SUGGESTION_UNITS_PER_DOCUMENT=3

# pragma: allowlist nextline secret (public local-development default)
DATABASE_URL=postgresql+psycopg://ai_idp:ai_idp@localhost:5432/ai_idp
LOCAL_STORAGE_ROOT=./data
LOCAL_TELEMETRY_ROOT=./telemetry

MAX_UPLOAD_MIB=200
MAX_PDF_PAGES=1000
MAX_DOCX_BLOCKS=1000
MAX_EXPANDED_MIB=1024
MAX_IMAGE_PIXELS=40000000
MAX_IMAGE_FRAMES=200
DOCUMENT_TIMEOUT_SECONDS=600
DOCUMENT_MEMORY_MIB=1024
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_MODEL_REQUESTS=12
PER_MODEL_CONCURRENCY={"*":8}
MODEL_REQUESTS_PER_MINUTE={"*":240}
PROVIDER_TIMEOUT_SECONDS=120
MAX_OUTPUT_TOKENS=8192
# Spreadsheet admission counts real cells; style-only blanks do not count.
MAX_SPREADSHEET_SHEETS=128
MAX_SPREADSHEET_CELLS=2000000
MAX_DOCUMENT_UNITS=10000
SPREADSHEET_ROWS_PER_UNIT=25
MAX_UNIT_TEXT_CHARACTERS=16000
MAX_DOCUMENT_TEXT_CHARACTERS=32000000
# Output pages are checkpointed and assembled by the application.
EXTRACTION_PAGE_ITEMS=25
MAX_EXTRACTION_PARTS=128
MAX_EXTRACTED_FIELDS=50000
MAX_RESULT_BYTES=33554432
RESULT_PAGE_BYTES=1048576
WORKER_LEASE_SECONDS=120
WORKER_POLL_SECONDS=1
WORKER_SHUTDOWN_SECONDS=30
MAX_PROVIDER_RETRIES=3
MAX_FIELD_EXTRA_ATTEMPTS=2
MAX_COVERAGE_REVIEWS=1
MAX_JOB_ESTIMATED_COST_USD=10
MAX_JOB_SECONDS=600
MAX_MODEL_CALLS=250
MAX_UNITS_PER_CALL=12
# One relevance question per unit, considering the entire extraction schema.
RELEVANCE_BATCH_UNITS=8
RELEVANCE_THRESHOLD=0.35
# Document-wide minimum retained units, not a separate floor per field.
RELEVANCE_TOP_K=2
MAX_DECISION_QUESTIONS_PER_CALL=24
MAX_PARALLEL_DECISION_BATCHES=8
MAX_DECISION_IMAGES_PER_CALL=8
MAX_MODEL_INPUT_BYTES=20971520
MAX_PREPARED_INPUT_MIB=256
TELEMETRY_MAX_MIB=10
TELEMETRY_RETAINED_FILES=20
VERIFICATION_SUPPORTED_THRESHOLD=0.50
MAX_FORMULA_CELLS=100000
MAX_FORMULA_STEPS=100000

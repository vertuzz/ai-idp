# Public example configuration only. Do not add real credentials to this file.

APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Configure a real credential only in your untracked local .env.
OPENROUTER_API_KEY=replace-me
OPENROUTER_DECISION_MODEL=perplexity/pplx-decider-v1.2
OPENROUTER_EXTRACTION_MODEL=replace-with-supported-cheap-multimodal-model
OPENROUTER_ESCALATION_MODEL=replace-with-supported-stronger-multimodal-model

DATABASE_URL=postgresql+psycopg://ai_idp:replace-me@localhost:5432/ai_idp
LOCAL_STORAGE_ROOT=./data
LOCAL_TELEMETRY_ROOT=./telemetry

MAX_UPLOAD_MIB=200
MAX_PDF_PAGES=1000
MAX_DOCX_BLOCKS=1000
MAX_EXPANDED_MIB=1024
MAX_IMAGE_PIXELS=40000000
MAX_CONCURRENT_JOBS=2
MAX_CONCURRENT_MODEL_REQUESTS=6
MAX_PROVIDER_RETRIES=3
MAX_FIELD_EXTRA_ATTEMPTS=2
MAX_COVERAGE_REVIEWS=1
MAX_JOB_ESTIMATED_COST_USD=10
